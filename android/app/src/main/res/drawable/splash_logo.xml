<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <!-- Background -->
  <rect width="512" height="512" fill="#FFFFFF"/>

  <!-- Logo Container -->
  <g transform="translate(256, 256)">
    <!-- Main Circle -->
    <circle cx="0" cy="0" r="140" fill="#3B82F6" opacity="0.1"/>
    <circle cx="0" cy="0" r="110" fill="#3B82F6" opacity="0.15"/>

    <!-- Icon - Cash Register / Receipt -->
    <g transform="translate(-60, -60)">
      <!-- Receipt Paper -->
      <rect x="30" y="0" width="60" height="90" rx="4" fill="#3B82F6"/>

      <!-- Receipt Lines -->
      <line x1="40" y1="15" x2="80" y2="15" stroke="white" stroke-width="3" stroke-linecap="round"/>
      <line x1="40" y1="30" x2="75" y2="30" stroke="white" stroke-width="3" stroke-linecap="round"/>
      <line x1="40" y1="45" x2="70" y2="45" stroke="white" stroke-width="3" stroke-linecap="round"/>
      <line x1="40" y1="60" x2="80" y2="60" stroke="white" stroke-width="3" stroke-linecap="round"/>
      <line x1="40" y1="75" x2="65" y2="75" stroke="white" stroke-width="3" stroke-linecap="round"/>

      <!-- Cash Symbol -->
      <circle cx="60" cy="110" r="20" fill="#10B981"/>
      <text x="60" y="120" font-family="Arial, sans-serif" font-size="24" font-weight="bold" fill="white" text-anchor="middle">Rp</text>
    </g>
  </g>

  <!-- App Name -->
  <text x="256" y="420" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#1F2937" text-anchor="middle">Tagih Kios</text>
  <text x="256" y="455" font-family="Arial, sans-serif" font-size="20" fill="#6B7280" text-anchor="middle">Kelola Toko dengan Mudah</text>
</svg>
