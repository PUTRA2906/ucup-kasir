{
  // Supabase CLI config untuk project Ucup Kasir.
  // Format JSONC (Supabase CLI v3+). Konfigurasi lengkap:
  // https://supabase.com/docs/guides/local-development/cli/config
  "$schema": "https://supabase.com/schemas/config/v1.json",

  "project_id": "ucup-kasir",

  "api": {
    "enabled": true,
    "port": 54321,
    "schemas": ["public", "graphql_public"],
    "extra_search_path": ["public", "extensions"],
    "max_rows": 1000
  },

  "db": {
    "port": 54322,
    "shadow_port": 54320,
    "health_timeout": "2m",
    // Harus sama dengan versi Postgres project live (xkfvukkpjrjqqqroujqs):
    // `select version()` -> PostgreSQL 17.11
    "major_version": 17,
    "migrations": {
      "enabled": true,
      "schema_paths": []
    },
    "seed": {
      "enabled": false,
      "sql_paths": []
    }
  },

  "realtime": {
    "enabled": true
  },

  "studio": {
    "enabled": true,
    "port": 54323,
    "api_url": "http://127.0.0.1"
  },

  "local_smtp": {
    "enabled": true,
    "port": 54324
  },

  "storage": {
    "enabled": true,
    "file_size_limit": "50MiB"
  },

  "auth": {
    "enabled": true,
    "site_url": "http://localhost:5173",
    "additional_redirect_urls": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ],
    "jwt_expiry": 3600,
    "enable_signup": true,
    "enable_anonymous_sign_ins": false,
    "minimum_password_length": 6,
    "email": {
      "enabled": true,
      "enable_confirmations": false
    }
  },

  "edge_runtime": {
    "enabled": true,
    "policy": "per_worker",
    "deno_version": 2
  }
}
